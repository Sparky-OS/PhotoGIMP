# Sparky Stereo OS, stereo pictures plug-in for GIMP 3: zh_CN strings
# SPDX-License-Identifier: GPL-3.0-or-later
msgid ""
msgstr ""
"Project-Id-Version: stereo-pictures\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"

msgid "Stereo pair"
msgstr "立体图像对"

msgid "Not a stereo MPO: no pair of disparity frames"
msgstr "不是立体 MPO 文件：没有视差帧对"

msgid "Two layers are needed: Left eye and Right eye"
msgstr "需要两个图层：Left eye 和 Right eye"

msgid "Side by side, left eye first"
msgstr "左右排列，左眼在前"

msgid "Side by side, right eye first (cross-eyed)"
msgstr "左右排列，右眼在前（交叉视）"

msgid "Top and bottom, left eye on top"
msgstr "上下排列，左眼在上"

msgid "Top and bottom, right eye on top"
msgstr "上下排列，右眼在上"

msgid "Stereo MPO picture"
msgstr "立体 MPO 图像"

msgid "Stereo JPS picture"
msgstr "立体 JPS 图像"

msgid "Stereo PNS picture"
msgstr "立体 PNS 图像"

msgid "Stereo %s picture"
msgstr "立体 %s 图像"

msgid "Load a stereo MPO (CIPA DC-007) as Left eye and Right eye layers"
msgstr "将立体 MPO（CIPA DC-007）载入为 Left eye 和 Right eye 图层"

msgid "Load a JPS (side-by-side JPEG) as Left eye and Right eye layers"
msgstr "将 JPS（左右排列的 JPEG）载入为 Left eye 和 Right eye 图层"

msgid "Load a PNS (side-by-side PNG with the sTER chunk) as Left eye and Right eye layers"
msgstr "将 PNS（带 sTER 数据块的左右排列 PNG）载入为 Left eye 和 Right eye 图层"

msgid "Export the Left eye and Right eye layers as a stereo %s file"
msgstr "将 Left eye 和 Right eye 图层导出为立体 %s 文件"

msgid "Quality"
msgstr "质量"

msgid "JPEG quality"
msgstr "JPEG 质量"

msgid "Layout"
msgstr "排列方式"

msgid "Which view comes first in the file"
msgstr "文件中哪一视图在前"

msgid "Split into eye layers"
msgstr "拆分为左右眼图层"

msgid "Split a side-by-side or top-and-bottom layer into Left eye and Right eye layers"
msgstr "将左右或上下排列的图层拆分为 Left eye 和 Right eye 图层"

msgid "How the views are packed in the layer"
msgstr "图层中视图的排列方式"

msgid "Join eye layers into a pair"
msgstr "将左右眼图层合并为图像对"

msgid "Join the Left eye and Right eye layers into one side-by-side or top-and-bottom layer"
msgstr "将 Left eye 和 Right eye 图层合并为一个左右或上下排列的图层"

msgid "How to pack the views"
msgstr "视图的排列方式"

msgid "Swap eyes"
msgstr "交换左右眼"

msgid "Exchange the Left eye and Right eye layers"
msgstr "交换 Left eye 和 Right eye 图层"

msgid "d = 0 px: screen plane"
msgstr "d = 0 px：屏幕平面"

msgid "d = +%d px: behind the screen"
msgstr "d = +%d px：屏幕后方"

msgid "d = %d px: in front of the screen"
msgstr "d = %d px：屏幕前方"

msgid "Not a side-by-side picture: nothing to set"
msgstr "不是左右排列的图像：无需设置"

msgid "Both eyes alike. %s. Paint tools repeat live with Image > Symmetry Painting > Tiling (interval X %d, two strokes), or after the file is saved and reopened; everything else: Stereo > Apply to both eyes."
msgstr "双眼一致。%s。绘画工具通过 图像 > 对称绘画 > 平铺（间隔 X %d，两笔）实时重复，或在保存并重新打开文件后生效；其他操作：立体 > 应用到双眼。"

msgid "Stereo editing is not set to Both eyes alike"
msgstr "立体编辑未设为双眼一致"

msgid "No snapshot to compare with: set Both eyes alike first"
msgstr "没有可比较的快照：请先设为双眼一致"

msgid "%d changed pixels repeated in the other eye (%s)"
msgstr "已将 %d 个更改的像素重复到另一眼 (%s)"

msgid "Stereo editing..."
msgstr "立体编辑..."

msgid "Each eye on its own, or both eyes alike: an edit in one view repeated in the other at the depth d"
msgstr "每只眼睛单独编辑，或双眼一致：一个视图中的编辑以深度 d 重复到另一视图"

msgid "Each eye on its own"
msgstr "每只眼睛单独编辑"

msgid "Both eyes alike"
msgstr "双眼一致"

msgid "Mode"
msgstr "模式"

msgid "How edits apply to the two views"
msgstr "编辑如何应用到两个视图"

msgid "Depth d (px)"
msgstr "深度 d (px)"

msgid "Shift of the repeat in the right view, in pixels: positive is behind the screen, negative in front, 0 the screen plane; no limits"
msgstr "右视图中重复内容的偏移（像素）：正值在屏幕后方，负值在前方，0 为屏幕平面；无限制"

msgid "Apply to both eyes"
msgstr "应用到双眼"

msgid "Repeat what changed in one view in the other view at the depth d"
msgstr "将一个视图中的更改以深度 d 重复到另一视图"

msgid "Right eye moved by %d px vertically"
msgstr "右眼已垂直移动 %d px"

msgid "Align eyes vertically (automatic)"
msgstr "垂直对齐双眼（自动）"

msgid "Estimate the vertical offset between the Left eye and Right eye layers and move the Right eye by it"
msgstr "估计 Left eye 与 Right eye 图层之间的垂直偏移，并据此移动 Right eye"

msgid "Search range (px)"
msgstr "搜索范围 (px)"

msgid "Largest vertical offset to look for, in pixels"
msgstr "要查找的最大垂直偏移（像素）"
