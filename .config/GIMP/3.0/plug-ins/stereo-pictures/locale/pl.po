msgid ""
msgstr ""
"Project-Id-Version: stereo-pictures\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"

msgid "Stereo pair"
msgstr "Para stereo"

msgid "Not a stereo MPO: no pair of disparity frames"
msgstr "To nie jest stereoskopowy plik MPO: brak pary klatek dysparycji"

msgid "Two layers are needed: Left eye and Right eye"
msgstr "Potrzebne są dwie warstwy: Left eye i Right eye"

msgid "Side by side, left eye first"
msgstr "Obok siebie, lewe oko pierwsze"

msgid "Side by side, right eye first (cross-eyed)"
msgstr "Obok siebie, prawe oko pierwsze (zez)"

msgid "Top and bottom, left eye on top"
msgstr "Góra i dół, lewe oko na górze"

msgid "Top and bottom, right eye on top"
msgstr "Góra i dół, prawe oko na górze"

msgid "Stereo MPO picture"
msgstr "Obraz stereo MPO"

msgid "Stereo JPS picture"
msgstr "Obraz stereo JPS"

msgid "Stereo PNS picture"
msgstr "Obraz stereo PNS"

msgid "Stereo %s picture"
msgstr "Obraz stereo %s"

msgid "Load a stereo MPO (CIPA DC-007) as Left eye and Right eye layers"
msgstr "Wczytuje stereoskopowy plik MPO (CIPA DC-007) jako warstwy Left eye i Right eye"

msgid "Load a JPS (side-by-side JPEG) as Left eye and Right eye layers"
msgstr "Wczytuje plik JPS (JPEG obok siebie) jako warstwy Left eye i Right eye"

msgid "Load a PNS (side-by-side PNG with the sTER chunk) as Left eye and Right eye layers"
msgstr "Wczytuje plik PNS (PNG obok siebie z blokiem sTER) jako warstwy Left eye i Right eye"

msgid "Export the Left eye and Right eye layers as a stereo %s file"
msgstr "Eksportuje warstwy Left eye i Right eye jako stereoskopowy plik %s"

msgid "Quality"
msgstr "Jakość"

msgid "JPEG quality"
msgstr "Jakość JPEG"

msgid "Layout"
msgstr "Układ"

msgid "Which view comes first in the file"
msgstr "Który widok jest pierwszy w pliku"

msgid "Split into eye layers"
msgstr "Podziel na warstwy oczu"

msgid "Split a side-by-side or top-and-bottom layer into Left eye and Right eye layers"
msgstr "Dzieli warstwę obok siebie lub góra-dół na warstwy Left eye i Right eye"

msgid "How the views are packed in the layer"
msgstr "Jak widoki są ułożone w warstwie"

msgid "Join eye layers into a pair"
msgstr "Połącz warstwy oczu w parę"

msgid "Join the Left eye and Right eye layers into one side-by-side or top-and-bottom layer"
msgstr "Łączy warstwy Left eye i Right eye w jedną warstwę obok siebie lub góra-dół"

msgid "How to pack the views"
msgstr "Jak ułożyć widoki"

msgid "Swap eyes"
msgstr "Zamień oczy"

msgid "Exchange the Left eye and Right eye layers"
msgstr "Zamienia warstwy Left eye i Right eye"
