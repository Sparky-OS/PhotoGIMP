msgid ""
msgstr ""
"Project-Id-Version: stereo-pictures\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"

msgid "Stereo pair"
msgstr "Para stereo"

msgid "Not a stereo MPO: no pair of disparity frames"
msgstr "To nie jest stereoskopowy plik MPO: brak pary klatek dysparycji"

msgid "Two layers are needed: Left eye and Right eye"
msgstr "Potrzebne są dwie warstwy: Left eye i Right eye"

msgid "Side by side, left eye first"
msgstr "Obok siebie, lewe oko pierwsze"

msgid "Side by side, right eye first (cross-eyed)"
msgstr "Obok siebie, prawe oko pierwsze (zez)"

msgid "Top and bottom, left eye on top"
msgstr "Góra i dół, lewe oko na górze"

msgid "Top and bottom, right eye on top"
msgstr "Góra i dół, prawe oko na górze"

msgid "Stereo MPO picture"
msgstr "Obraz stereo MPO"

msgid "Stereo JPS picture"
msgstr "Obraz stereo JPS"

msgid "Stereo PNS picture"
msgstr "Obraz stereo PNS"

msgid "Stereo %s picture"
msgstr "Obraz stereo %s"

msgid "Load a stereo MPO (CIPA DC-007) as Left eye and Right eye layers"
msgstr "Wczytuje stereoskopowy plik MPO (CIPA DC-007) jako warstwy Left eye i Right eye"

msgid "Load a JPS (side-by-side JPEG) as Left eye and Right eye layers"
msgstr "Wczytuje plik JPS (JPEG obok siebie) jako warstwy Left eye i Right eye"

msgid "Load a PNS (side-by-side PNG with the sTER chunk) as Left eye and Right eye layers"
msgstr "Wczytuje plik PNS (PNG obok siebie z blokiem sTER) jako warstwy Left eye i Right eye"

msgid "Export the Left eye and Right eye layers as a stereo %s file"
msgstr "Eksportuje warstwy Left eye i Right eye jako stereoskopowy plik %s"

msgid "Quality"
msgstr "Jakość"

msgid "JPEG quality"
msgstr "Jakość JPEG"

msgid "Layout"
msgstr "Układ"

msgid "Which view comes first in the file"
msgstr "Który widok jest pierwszy w pliku"

msgid "Split into eye layers"
msgstr "Podziel na warstwy oczu"

msgid "Split a side-by-side or top-and-bottom layer into Left eye and Right eye layers"
msgstr "Dzieli warstwę obok siebie lub góra-dół na warstwy Left eye i Right eye"

msgid "How the views are packed in the layer"
msgstr "Jak widoki są ułożone w warstwie"

msgid "Join eye layers into a pair"
msgstr "Połącz warstwy oczu w parę"

msgid "Join the Left eye and Right eye layers into one side-by-side or top-and-bottom layer"
msgstr "Łączy warstwy Left eye i Right eye w jedną warstwę obok siebie lub góra-dół"

msgid "How to pack the views"
msgstr "Jak ułożyć widoki"

msgid "Swap eyes"
msgstr "Zamień oczy"

msgid "Exchange the Left eye and Right eye layers"
msgstr "Zamienia warstwy Left eye i Right eye"

msgid "d = 0 px: screen plane"
msgstr "d = 0 px: płaszczyzna ekranu"

msgid "d = +%d px: behind the screen"
msgstr "d = +%d px: za ekranem"

msgid "d = %d px: in front of the screen"
msgstr "d = %d px: przed ekranem"

msgid "Not a side-by-side picture: nothing to set"
msgstr "To nie jest obraz obok siebie: nic do ustawienia"

msgid "Both eyes alike. %s. Paint tools repeat live with Image > Symmetry Painting > Tiling (interval X %d, two strokes), or after the file is saved and reopened; everything else: Stereo > Apply to both eyes."
msgstr "Oba oczy jednakowo. %s. Narzędzia malowania powtarzają na żywo przez Obraz > Malowanie symetryczne > Kafelki (odstęp X %d, dwa pociągnięcia) albo po zapisaniu i ponownym otwarciu pliku; wszystko inne: Stereo > Zastosuj do obu oczu."

msgid "Stereo editing is not set to Both eyes alike"
msgstr "Edycja stereo nie jest ustawiona na Oba oczy jednakowo"

msgid "No snapshot to compare with: set Both eyes alike first"
msgstr "Brak migawki do porównania: najpierw ustaw Oba oczy jednakowo"

msgid "%d changed pixels repeated in the other eye (%s)"
msgstr "%d zmienionych pikseli powtórzono w drugim oku (%s)"

msgid "Stereo editing..."
msgstr "Edycja stereo..."

msgid "Each eye on its own, or both eyes alike: an edit in one view repeated in the other at the depth d"
msgstr "Każde oko osobno albo oba oczy jednakowo: edycja w jednym widoku powtórzona w drugim na głębokości d"

msgid "Each eye on its own"
msgstr "Każde oko osobno"

msgid "Both eyes alike"
msgstr "Oba oczy jednakowo"

msgid "Mode"
msgstr "Tryb"

msgid "How edits apply to the two views"
msgstr "Jak edycje działają na dwa widoki"

msgid "Depth d (px)"
msgstr "Głębokość d (px)"

msgid "Shift of the repeat in the right view, in pixels: positive is behind the screen, negative in front, 0 the screen plane; no limits"
msgstr "Przesunięcie powtórzenia w prawym widoku, w pikselach: dodatnie za ekranem, ujemne przed nim, 0 to płaszczyzna ekranu; bez ograniczeń"

msgid "Apply to both eyes"
msgstr "Zastosuj do obu oczu"

msgid "Repeat what changed in one view in the other view at the depth d"
msgstr "Powtarza to, co zmieniło się w jednym widoku, w drugim na głębokości d"

msgid "Right eye moved by %d px vertically"
msgstr "Prawe oko przesunięte w pionie o %d px"

msgid "Align eyes vertically (automatic)"
msgstr "Wyrównaj oczy w pionie (automatycznie)"

msgid "Estimate the vertical offset between the Left eye and Right eye layers and move the Right eye by it"
msgstr "Szacuje pionowe przesunięcie między warstwami Left eye i Right eye i przesuwa o nie Right eye"

msgid "Search range (px)"
msgstr "Zakres szukania (px)"

msgid "Largest vertical offset to look for, in pixels"
msgstr "Największe pionowe przesunięcie do wyszukania, w pikselach"
