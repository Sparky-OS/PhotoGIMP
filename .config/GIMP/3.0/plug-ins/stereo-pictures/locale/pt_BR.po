# Sparky Stereo OS, stereo pictures plug-in for GIMP 3: pt_BR strings
# SPDX-License-Identifier: GPL-3.0-or-later
msgid ""
msgstr ""
"Project-Id-Version: stereo-pictures\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"

msgid "Stereo pair"
msgstr "Par estéreo"

msgid "Not a stereo MPO: no pair of disparity frames"
msgstr "Não é um MPO estéreo: não há par de quadros de disparidade"

msgid "Two layers are needed: Left eye and Right eye"
msgstr "São necessárias duas camadas: Left eye e Right eye"

msgid "Side by side, left eye first"
msgstr "Lado a lado, olho esquerdo primeiro"

msgid "Side by side, right eye first (cross-eyed)"
msgstr "Lado a lado, olho direito primeiro (visão cruzada)"

msgid "Top and bottom, left eye on top"
msgstr "Em cima e embaixo, olho esquerdo em cima"

msgid "Top and bottom, right eye on top"
msgstr "Em cima e embaixo, olho direito em cima"

msgid "Stereo MPO picture"
msgstr "Imagem estéreo MPO"

msgid "Stereo JPS picture"
msgstr "Imagem estéreo JPS"

msgid "Stereo PNS picture"
msgstr "Imagem estéreo PNS"

msgid "Stereo %s picture"
msgstr "Imagem estéreo %s"

msgid "Load a stereo MPO (CIPA DC-007) as Left eye and Right eye layers"
msgstr "Carrega um MPO estéreo (CIPA DC-007) como camadas Left eye e Right eye"

msgid "Load a JPS (side-by-side JPEG) as Left eye and Right eye layers"
msgstr "Carrega um JPS (JPEG lado a lado) como camadas Left eye e Right eye"

msgid "Load a PNS (side-by-side PNG with the sTER chunk) as Left eye and Right eye layers"
msgstr "Carrega um PNS (PNG lado a lado com o bloco sTER) como camadas Left eye e Right eye"

msgid "Export the Left eye and Right eye layers as a stereo %s file"
msgstr "Exporta as camadas Left eye e Right eye como um arquivo estéreo %s"

msgid "Quality"
msgstr "Qualidade"

msgid "JPEG quality"
msgstr "Qualidade JPEG"

msgid "Layout"
msgstr "Disposição"

msgid "Which view comes first in the file"
msgstr "Qual vista vem primeiro no arquivo"

msgid "Split into eye layers"
msgstr "Dividir em camadas por olho"

msgid "Split a side-by-side or top-and-bottom layer into Left eye and Right eye layers"
msgstr "Divide uma camada lado a lado ou em cima e embaixo nas camadas Left eye e Right eye"

msgid "How the views are packed in the layer"
msgstr "Como as vistas estão dispostas na camada"

msgid "Join eye layers into a pair"
msgstr "Juntar as camadas dos olhos em um par"

msgid "Join the Left eye and Right eye layers into one side-by-side or top-and-bottom layer"
msgstr "Junta as camadas Left eye e Right eye em uma camada lado a lado ou em cima e embaixo"

msgid "How to pack the views"
msgstr "Como dispor as vistas"

msgid "Swap eyes"
msgstr "Trocar os olhos"

msgid "Exchange the Left eye and Right eye layers"
msgstr "Troca as camadas Left eye e Right eye"

msgid "d = 0 px: screen plane"
msgstr "d = 0 px: plano da tela"

msgid "d = +%d px: behind the screen"
msgstr "d = +%d px: atrás da tela"

msgid "d = %d px: in front of the screen"
msgstr "d = %d px: na frente da tela"

msgid "Not a side-by-side picture: nothing to set"
msgstr "Não é uma imagem lado a lado: nada a definir"

msgid "Both eyes alike. %s. Paint tools repeat live with Image > Symmetry Painting > Tiling (interval X %d, two strokes), or after the file is saved and reopened; everything else: Stereo > Apply to both eyes."
msgstr "Ambos os olhos iguais. %s. As ferramentas de pintura repetem ao vivo com Imagem > Pintura simétrica > Ladrilho (intervalo X %d, dois traços), ou depois de salvar e reabrir o arquivo; o resto: Estéreo > Aplicar aos dois olhos."

msgid "Stereo editing is not set to Both eyes alike"
msgstr "A edição estéreo não está em Ambos os olhos iguais"

msgid "No snapshot to compare with: set Both eyes alike first"
msgstr "Não há instantâneo para comparar: defina Ambos os olhos iguais primeiro"

msgid "%d changed pixels repeated in the other eye (%s)"
msgstr "%d pixels alterados repetidos no outro olho (%s)"

msgid "Stereo editing..."
msgstr "Edição estéreo..."

msgid "Each eye on its own, or both eyes alike: an edit in one view repeated in the other at the depth d"
msgstr "Cada olho por si, ou ambos os olhos iguais: uma edição em uma vista repetida na outra à profundidade d"

msgid "Each eye on its own"
msgstr "Cada olho por si"

msgid "Both eyes alike"
msgstr "Ambos os olhos iguais"

msgid "Mode"
msgstr "Modo"

msgid "How edits apply to the two views"
msgstr "Como as edições se aplicam às duas vistas"

msgid "Depth d (px)"
msgstr "Profundidade d (px)"

msgid "Shift of the repeat in the right view, in pixels: positive is behind the screen, negative in front, 0 the screen plane; no limits"
msgstr "Deslocamento da repetição na vista direita, em pixels: positivo atrás da tela, negativo na frente, 0 o plano da tela; sem limites"

msgid "Apply to both eyes"
msgstr "Aplicar aos dois olhos"

msgid "Repeat what changed in one view in the other view at the depth d"
msgstr "Repete o que mudou em uma vista na outra vista à profundidade d"

msgid "Right eye moved by %d px vertically"
msgstr "Olho direito movido %d px na vertical"

msgid "Align eyes vertically (automatic)"
msgstr "Alinhar os olhos na vertical (automático)"

msgid "Estimate the vertical offset between the Left eye and Right eye layers and move the Right eye by it"
msgstr "Estima o deslocamento vertical entre as camadas Left eye e Right eye e move a Right eye por ele"

msgid "Search range (px)"
msgstr "Faixa de busca (px)"

msgid "Largest vertical offset to look for, in pixels"
msgstr "Maior deslocamento vertical a procurar, em pixels"
