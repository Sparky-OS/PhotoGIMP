msgid ""
msgstr ""
"Project-Id-Version: stereo-pictures\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"

msgid "Stereo pair"
msgstr "Par estéreo"

msgid "Not a stereo MPO: no pair of disparity frames"
msgstr "Não é um MPO estéreo: não há par de quadros de disparidade"

msgid "Two layers are needed: Left eye and Right eye"
msgstr "São necessárias duas camadas: Left eye e Right eye"

msgid "Side by side, left eye first"
msgstr "Lado a lado, olho esquerdo primeiro"

msgid "Side by side, right eye first (cross-eyed)"
msgstr "Lado a lado, olho direito primeiro (visão cruzada)"

msgid "Top and bottom, left eye on top"
msgstr "Em cima e embaixo, olho esquerdo em cima"

msgid "Top and bottom, right eye on top"
msgstr "Em cima e embaixo, olho direito em cima"

msgid "Stereo MPO picture"
msgstr "Imagem estéreo MPO"

msgid "Stereo JPS picture"
msgstr "Imagem estéreo JPS"

msgid "Stereo PNS picture"
msgstr "Imagem estéreo PNS"

msgid "Stereo %s picture"
msgstr "Imagem estéreo %s"

msgid "Load a stereo MPO (CIPA DC-007) as Left eye and Right eye layers"
msgstr "Carrega um MPO estéreo (CIPA DC-007) como camadas Left eye e Right eye"

msgid "Load a JPS (side-by-side JPEG) as Left eye and Right eye layers"
msgstr "Carrega um JPS (JPEG lado a lado) como camadas Left eye e Right eye"

msgid "Load a PNS (side-by-side PNG with the sTER chunk) as Left eye and Right eye layers"
msgstr "Carrega um PNS (PNG lado a lado com o bloco sTER) como camadas Left eye e Right eye"

msgid "Export the Left eye and Right eye layers as a stereo %s file"
msgstr "Exporta as camadas Left eye e Right eye como um arquivo estéreo %s"

msgid "Quality"
msgstr "Qualidade"

msgid "JPEG quality"
msgstr "Qualidade JPEG"

msgid "Layout"
msgstr "Disposição"

msgid "Which view comes first in the file"
msgstr "Qual vista vem primeiro no arquivo"

msgid "Split into eye layers"
msgstr "Dividir em camadas por olho"

msgid "Split a side-by-side or top-and-bottom layer into Left eye and Right eye layers"
msgstr "Divide uma camada lado a lado ou em cima e embaixo nas camadas Left eye e Right eye"

msgid "How the views are packed in the layer"
msgstr "Como as vistas estão dispostas na camada"

msgid "Join eye layers into a pair"
msgstr "Juntar as camadas dos olhos em um par"

msgid "Join the Left eye and Right eye layers into one side-by-side or top-and-bottom layer"
msgstr "Junta as camadas Left eye e Right eye em uma camada lado a lado ou em cima e embaixo"

msgid "How to pack the views"
msgstr "Como dispor as vistas"

msgid "Swap eyes"
msgstr "Trocar os olhos"

msgid "Exchange the Left eye and Right eye layers"
msgstr "Troca as camadas Left eye e Right eye"
